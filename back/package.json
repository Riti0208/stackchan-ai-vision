{
  "name": "stackchan-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/wrangler.mjs dev --config wrangler.local.jsonc --ip 127.0.0.1 --port 8787",
    "demo": "node scripts/demo.mjs",
    "sim": "node scripts/fw-simulator.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.mjs test/luna-e2e.test.mjs test/paid-e2e.test.mjs",
    "build": "node scripts/wrangler.mjs deploy --dry-run --outdir dist",
    "deploy": "node scripts/wrangler.mjs deploy",
    "test:unit": "node --experimental-strip-types --test test/social.test.mjs test/openai.test.mjs test/local-env.test.mjs test/perception.test.mjs test/human-actions.test.mjs test/telemetry.test.mjs test/paid-session.test.mjs",
    "demo:openai": "node scripts/demo.mjs --openai",
    "check:openai": "node --experimental-strip-types scripts/check-openai.mjs",
    "check:affect": "node --experimental-strip-types scripts/check-affect.mjs",
    "metrics": "node --experimental-strip-types scripts/collect-metrics.mjs"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "typescript": "~5.9.3",
    "wrangler": "4.151.1"
  }
}
