{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stackchan-ai-vision",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    }
  ],
  "vars": {
    "AI_MODE": "mock",
    "ENABLE_LAB": "false",
    "ENABLE_PAID_CONTROL": "true",
    "PAID_CONTROL_ROOM": "main",
    "STREAM_FPS": "60",
    "EVAL_INTERVAL_MS": "1000",
    "NARRATION_INTERVAL_MS": "2000"
  },
  "assets": {
    "directory": "../front/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": {
    "command": "npm --prefix ../front run build"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "version_metadata": {
    "binding": "VERSION_METADATA"
  }
}
